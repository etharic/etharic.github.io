    "scene": {
      "renderer": "three.js r170, WebGL, low-power, pixel ratio max 2, ACES filmic tone mapping, sRGB output; lazy-loaded, optional",
      "sign": "trivision: 12 slats, BoxGeometry square section (4.2/12 minus .014 gap) x 1.5 tall; panel 4.2 x 1.5 world units; slat side groups +z, -x, -z, +x carry faces 0-3",
      "rails": "top and bottom RoundedBoxGeometry bars 4.36 x .045 x (slat depth + .05); #26272b light / #45464c dark, roughness .38, metalness .25, clearcoat .4",
      "faceMaterial": "MeshPhysicalMaterial roughness .62, clearcoat .12, clearcoatRoughness .5; map = slice k/12 of a 2048 x 731 canvas per audience",
      "slatEnds": "#d9d6cf light / #3a3b40 dark, roughness .5, clearcoat .2",
      "faceLayout": "tag Inter 600 62px at (120, 170); line Archivo 700 expanded, 330px down to 90px in 8px steps until it fits two lines within width - 240, set at x 114 centred in the band from y 230 to h - 90",
      "faces": {
